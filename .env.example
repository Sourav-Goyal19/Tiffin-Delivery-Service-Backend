# ============================================================
# Tiffin Delivery Service - Environment Variables (Example)
# ============================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# The .env file is gitignored and should never be committed.
# ============================================================

# --- Database (PostgreSQL / Neon) ---
# Full JDBC URL for the application datasource.
# Do NOT embed username/password in the URL; use the
# separate DB_USERNAME and DB_PASSWORD properties instead.
DATABASE_URL=

# Database username (e.g., "neondb_owner")
DB_USERNAME=

# Database password (e.g., "npg_LJv6OuP1qQFh")
DB_PASSWORD=

# --- Postgres Listener (for LISTEN/NOTIFY triggers) ---
# Separate connection URL for the notification listener.
# This can be a direct (non-pooled) connection to the same database.
POSTGRES_LISTENER_URL=

# Username for the listener connection (same as DB_USERNAME)
POSTGRES_LISTENER_USERNAME=

# Password for the listener connection (same as DB_PASSWORD)
POSTGRES_LISTENER_PASSWORD=

# --- JWT ---
# Secret key used to sign JWT tokens (64-char hex string recommended)
JWT_SECRET_KEY=

# --- MinIO (S3-compatible object storage) ---
# Access key (aka access name) for MinIO
MINIO_ACCESS_NAME=

# Secret key for MinIO access
MINIO_ACCESS_SECRET=

# --- Razorpay (Payment Gateway) ---
# Public API key from Razorpay dashboard
RAZORPAY_API_KEY=

# Private API secret from Razorpay dashboard
RAZORPAY_API_SECRET=

# Webhook signing secret from Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# --- Redis ---
# Password for the Redis instance
REDIS_PASSWORD=

# --- Google Maps ---
# API key for Google Maps Routes API
GOOGLE_MAPS_API_KEY=
